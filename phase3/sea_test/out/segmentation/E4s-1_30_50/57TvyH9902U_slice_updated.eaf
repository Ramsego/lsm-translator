		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4517" TIME_SLOT_REF1="ts9032" TIME_SLOT_REF2="ts9033">
				<ANNOTATION_VALUE>También tenemos dependencias internacionales como la ONU, donde están dando pláticas contra las drogas y, sobre todo, en el tema de la política del turismo deportivo.</ANNOTATION_VALUE>
