		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4543" TIME_SLOT_REF1="ts9084" TIME_SLOT_REF2="ts9085">
				<ANNOTATION_VALUE>¿Perdiste tu pasaporte o algún documento importante?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4544" TIME_SLOT_REF1="ts9086" TIME_SLOT_REF2="ts9087">
				<ANNOTATION_VALUE>¿Tuviste un problema con algún servicio turístico o necesitas ayuda?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
