				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4221" TIME_SLOT_REF1="ts8440" TIME_SLOT_REF2="ts8441">
				<ANNOTATION_VALUE>¡Nos vamos al mundial!</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4222" TIME_SLOT_REF1="ts8442" TIME_SLOT_REF2="ts8443">
				<ANNOTATION_VALUE>La va a romper en la selección y pues espero estar ahí presente.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4223" TIME_SLOT_REF1="ts8444" TIME_SLOT_REF2="ts8445">
				<ANNOTATION_VALUE>Muchísimas gracias de corazón.</ANNOTATION_VALUE>
