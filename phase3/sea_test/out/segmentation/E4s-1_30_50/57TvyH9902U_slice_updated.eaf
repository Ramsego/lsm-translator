		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4526" TIME_SLOT_REF1="ts9050" TIME_SLOT_REF2="ts9051">
				<ANNOTATION_VALUE>Recuerden que ahí puedes consultar cómo turistar por todo México, desde la ciudad de Cedes, 290 rutas, qué comer, etcétera.</ANNOTATION_VALUE>
