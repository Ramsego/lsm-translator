		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4545" TIME_SLOT_REF1="ts9088" TIME_SLOT_REF2="ts9089">
				<ANNOTATION_VALUE>¿Requieres ayuda médica o atención ante una emergencia?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4546" TIME_SLOT_REF1="ts9090" TIME_SLOT_REF2="ts9091">
				<ANNOTATION_VALUE>En los kioscos México contigo encontrarás acompañamiento y canalización con las instituciones correspondientes.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4547" TIME_SLOT_REF1="ts9092" TIME_SLOT_REF2="ts9093">
				<ANNOTATION_VALUE>Porque queremos que disfrutes cada experiencia con tranquilidad y confianza.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4548" TIME_SLOT_REF1="ts9094" TIME_SLOT_REF2="ts9095">
				<ANNOTATION_VALUE>Y que sepas que siempre hay un lugar al cual puedes acudir.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4549" TIME_SLOT_REF1="ts9096" TIME_SLOT_REF2="ts9097">
				<ANNOTATION_VALUE>Sin importar tu nacionalidad, tu idioma o quién eres.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4550" TIME_SLOT_REF1="ts9098" TIME_SLOT_REF2="ts9099">
				<ANNOTATION_VALUE>México contigo es un espacio seguro, incluyente y pensado para ti.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4551" TIME_SLOT_REF1="ts9100" TIME_SLOT_REF2="ts9101">
				<ANNOTATION_VALUE>Descubre nuestras ciudades.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4552" TIME_SLOT_REF1="ts9102" TIME_SLOT_REF2="ts9103">
				<ANNOTATION_VALUE>Y disfruta cada momento con la confianza de que México está contigo.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4553" TIME_SLOT_REF1="ts9104" TIME_SLOT_REF2="ts9105">
				<ANNOTATION_VALUE>Ten a vivir la emoción del fútbol porque México está de buena.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4554" TIME_SLOT_REF1="ts9106" TIME_SLOT_REF2="ts9107">
				<ANNOTATION_VALUE>Con su permiso, presidenta.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4555" TIME_SLOT_REF1="ts9108" TIME_SLOT_REF2="ts9109">
				<ANNOTATION_VALUE>Muy buenos días a todas y a todos.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4556" TIME_SLOT_REF1="ts9110" TIME_SLOT_REF2="ts9111">
				<ANNOTATION_VALUE>Primero informar que el día de ayer se desarrollaron en la ciudad de México dos movilizaciones relevantes.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4557" TIME_SLOT_REF1="ts9112" TIME_SLOT_REF2="ts9113">
				<ANNOTATION_VALUE>La primera integrada por aproximadamente dos mil personas que partió del casco de Santo Tomás, hacia el cine Cosmos.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4558" TIME_SLOT_REF1="ts9114" TIME_SLOT_REF2="ts9115">
				<ANNOTATION_VALUE>Esto en conmemoración de hechos sucedidos en 1971, conocidos como el Alconazo.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4559" TIME_SLOT_REF1="ts9116" TIME_SLOT_REF2="ts9117">
				<ANNOTATION_VALUE>Se llevó a cabo esta movilización de manera ordenada y concluyó sin incidentes.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4560" TIME_SLOT_REF1="ts9118" TIME_SLOT_REF2="ts9119">
				<ANNOTATION_VALUE>La segunda movilización se efectuó por la noche.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4561" TIME_SLOT_REF1="ts9120" TIME_SLOT_REF2="ts9121">
				<ANNOTATION_VALUE>Estuvo conformada por varios cientos de personas entre ellas madres y padres y familiares de personas desaparecidas, así como integrantes de colectivos y organizaciones que acompañan su causa.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4562" TIME_SLOT_REF1="ts9122" TIME_SLOT_REF2="ts9123">
				<ANNOTATION_VALUE>En esta movilización, la Secretaría de Gobernación estuvo presente en todo momento, junto con la Comisionada Nacional de Búsqueda y la Comisión Ejecutiva de Atención a Víctimas, brindando atención y acompañamiento a las familias participantes.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4563" TIME_SLOT_REF1="ts9124" TIME_SLOT_REF2="ts9125">
				<ANNOTATION_VALUE>Respecto de esta manifestación, expresar en primer lugar nuestro respeto, solidaridad, a las madres y familias buscadoras.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4564" TIME_SLOT_REF1="ts9126" TIME_SLOT_REF2="ts9127">
				<ANNOTATION_VALUE>Comprendemos lo que representa la ausencia de un ser querido y reiteramos que el Gobierno de México trabaja todos los días en coordinación con las autoridades estatales y las instituciones competentes en la localización de personas desaparecidas.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4565" TIME_SLOT_REF1="ts9128" TIME_SLOT_REF2="ts9129">
				<ANNOTATION_VALUE>Las buscadoras y los colectivos han sido atendidos de manera permanente y lo seguiremos haciendo con todo nuestro esfuerzo.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4566" TIME_SLOT_REF1="ts9130" TIME_SLOT_REF2="ts9131">
				<ANNOTATION_VALUE>También es importante señalar que contamos con información que indica la presencia no solamente de los colectivos de la Ciudad de México y los colectivos de Jalisco, sino que algunas personas provenientes del Estado de Jalisco recibieron apoyo para trasladarse a esta movilización.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4567" TIME_SLOT_REF1="ts9132" TIME_SLOT_REF2="ts9133">
				<ANNOTATION_VALUE>Estamos recabando toda la información para conocer el origen de esos apoyos y determinar si existió alguna intención ajena a la legítima exigencia de búsqueda y justicia que encabezan las familias.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4568" TIME_SLOT_REF1="ts9134" TIME_SLOT_REF2="ts9135">
				<ANNOTATION_VALUE>Por otra parte, también hoy la CENTE ha expresado públicamente que la movilización prevista para esta mañana se hará de manera pacífica.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4569" TIME_SLOT_REF1="ts9136" TIME_SLOT_REF2="ts9137">
				<ANNOTATION_VALUE>Por otra parte, y ya respecto al inicio de la Copa Mundial de Fútbol 2026, queremos ser muy claros, el Mundial va y se desarrollará con normalidad.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4570" TIME_SLOT_REF1="ts9138" TIME_SLOT_REF2="ts9139">
				<ANNOTATION_VALUE>A todas las personas que acudirán a los eventos relacionados con la inauguración de la Copa Mundial de Fútbol les informamos que existen las condiciones necesarias para garantizar su acceso, su seguridad y el desarrollo de las actividades programadas.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4571" TIME_SLOT_REF1="ts9140" TIME_SLOT_REF2="ts9141">
				<ANNOTATION_VALUE>En conjunto con el gobierno de la Ciudad de México, con todas las autoridades del gobierno de México, nosotros podemos garantizar la normalidad de las actividades.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4572" TIME_SLOT_REF1="ts9142" TIME_SLOT_REF2="ts9143">
				<ANNOTATION_VALUE>México está listo para recibir a miles de visitantes en nuestro país y esta es una fiesta para los amantes del fútbol, pero también una celebración.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4573" TIME_SLOT_REF1="ts9144" TIME_SLOT_REF2="ts9145">
				<ANNOTATION_VALUE>Les damos la bienvenida y reiteramos nuestro compromiso para que esta jornada se desarrolle en paz, tranquilidad y con pleno respeto a los derechos de todas y de todos.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4574" TIME_SLOT_REF1="ts9146" TIME_SLOT_REF2="ts9147">
				<ANNOTATION_VALUE>Con su permiso, presidenta.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4575" TIME_SLOT_REF1="ts9148" TIME_SLOT_REF2="ts9149">
				<ANNOTATION_VALUE>Para informarles de la reunión que tuvimos ayer en la Secretaría de Gobernación, encabezado por la secretaria Rosa Isela, por el director del Issste, Martí Batres, y su servidor y el equipo de la Secretaría de Educación Pública, invitamos a las y los maestros del Asente a reunirnos nuevamente.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4576" TIME_SLOT_REF1="ts9150" TIME_SLOT_REF2="ts9151">
				<ANNOTATION_VALUE>Es la cuarta reunión.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4577" TIME_SLOT_REF1="ts9152" TIME_SLOT_REF2="ts9153">
				<ANNOTATION_VALUE>¿Por qué los convocamos?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4578" TIME_SLOT_REF1="ts9154" TIME_SLOT_REF2="ts9155">
				<ANNOTATION_VALUE>Porque tenemos una voluntad de diálogo permanente.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4579" TIME_SLOT_REF1="ts9156" TIME_SLOT_REF2="ts9157">
				<ANNOTATION_VALUE>Pero les teníamos preparada mucha más información de las propuestas que ha hecho el gobierno de México a dos de sus principales demandas.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4580" TIME_SLOT_REF1="ts9158" TIME_SLOT_REF2="ts9159">
				<ANNOTATION_VALUE>El tema de la UCCAM.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4581" TIME_SLOT_REF1="ts9160" TIME_SLOT_REF2="ts9161">
				<ANNOTATION_VALUE>Hicimos una amplísima exposición de cómo ha cambiado históricamente el marco jurídico, cómo ha cambiado la relación entre el Estado mexicano y los maestros.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4582" TIME_SLOT_REF1="ts9162" TIME_SLOT_REF2="ts9163">
				<ANNOTATION_VALUE>Desde 1946 a la fecha, cómo evolucionó la regulación en el apartado B del artículo 123, luego la reforma al tercero constitucional.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4583" TIME_SLOT_REF1="ts9164" TIME_SLOT_REF2="ts9165">
				<ANNOTATION_VALUE>Es una información muy útil para atender el planteamiento que ha hecho nuestra presidenta.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4584" TIME_SLOT_REF1="ts9166" TIME_SLOT_REF2="ts9167">
				<ANNOTATION_VALUE>En su compromiso número 27 de los 100 que le hizo a la nación, a partir de múltiples peticiones de maestros en todo el país y maestras que le decían a la presidenta en su campaña, queremos cambiar a la UCCAM.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4585" TIME_SLOT_REF1="ts9168" TIME_SLOT_REF2="ts9169">
				<ANNOTATION_VALUE>Entonces ahí está el compromiso de campaña que se va a atender.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4586" TIME_SLOT_REF1="ts9170" TIME_SLOT_REF2="ts9171">
				<ANNOTATION_VALUE>¿Qué queremos?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4587" TIME_SLOT_REF1="ts9172" TIME_SLOT_REF2="ts9173">
				<ANNOTATION_VALUE>¿A qué los invitamos a ellos?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4588" TIME_SLOT_REF1="ts9174" TIME_SLOT_REF2="ts9175">
				<ANNOTATION_VALUE>A que participen en el diseño que vamos a hacer de esta reforma, de esta iniciativa.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4589" TIME_SLOT_REF1="ts9176" TIME_SLOT_REF2="ts9177">
				<ANNOTATION_VALUE>Sin embargo, pues ya hay un rechazo a una iniciativa que todavía no existe.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4590" TIME_SLOT_REF1="ts9178" TIME_SLOT_REF2="ts9179">
				<ANNOTATION_VALUE>Entonces les dijimos, bueno, pues para que no tengan dudas, participen en una mesa con sus abogados, una mesa técnica, y que vayan dando cuenta que se consideren sus aportaciones en la construcción de esta ley.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4591" TIME_SLOT_REF1="ts9180" TIME_SLOT_REF2="ts9181">
				<ANNOTATION_VALUE>Pero lo que está claro es que no podemos quedarnos nada más escuchando a un grupo de maestros.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4592" TIME_SLOT_REF1="ts9182" TIME_SLOT_REF2="ts9183">
				<ANNOTATION_VALUE>La presidenta ha dicho, esta reforma es tan importante porque va a definir, va a tener mucho impacto en la vida de las y los maestros, por lo tanto, las y los maestros deben decidir.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4593" TIME_SLOT_REF1="ts9184" TIME_SLOT_REF2="ts9185">
				<ANNOTATION_VALUE>Por eso ya anunciamos, es nuestro plan de trabajo que vamos a cumplir.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4594" TIME_SLOT_REF1="ts9186" TIME_SLOT_REF2="ts9187">
				<ANNOTATION_VALUE>Vamos a hacer una consulta, escuela por escuela, maestro por maestro, para que ellos decidan esta nueva relación entre el Estado y el Magisterio, donde prevalezca los derechos laborales, la transparencia y erradiquemos cualquier posibilidad de caer en los vicios que había en el pasado, de corrupción, de amigismo, de nepotismo, de influyentismo y de venta de plazas.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4595" TIME_SLOT_REF1="ts9188" TIME_SLOT_REF2="ts9189">
				<ANNOTATION_VALUE>No vamos a regresar a eso.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4596" TIME_SLOT_REF1="ts9190" TIME_SLOT_REF2="ts9191">
				<ANNOTATION_VALUE>Y como somos un movimiento que viene directamente del pueblo, de escuchar a la gente, pues tenemos que ir abajo con el pueblo, con el maestro que está frente a grupo, que él pueda hablar, no nada más quedarnos con una representación, sino que las y los maestros decidan.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4597" TIME_SLOT_REF1="ts9192" TIME_SLOT_REF2="ts9193">
				<ANNOTATION_VALUE>Esa es la intención.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4598" TIME_SLOT_REF1="ts9194" TIME_SLOT_REF2="ts9195">
				<ANNOTATION_VALUE>Y ya anunciamos que en el regreso a clases, en agosto, en esta semana, donde los maestros siempre entran una semana antes a clase, porque preparan el siguiente ciclo escolar, entonces es el marco ideal para tener esta discusión sobre el UCICAM y que ellos puedan decidir, por ejemplo, quién debe decidir sobre el ingreso de los maestros, sobre los ascensos, sobre las promociones.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4599" TIME_SLOT_REF1="ts9196" TIME_SLOT_REF2="ts9197">
				<ANNOTATION_VALUE>Hay varias alternativas.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4600" TIME_SLOT_REF1="ts9198" TIME_SLOT_REF2="ts9199">
				<ANNOTATION_VALUE>Una es que sean los propios maestros, que sean decisiones entre pares, un grupo que se elija de maestros y que ellos elijan o irte a lo que había en el pasado antes, de antes en el gobierno neoliberal, donde pues era una práctica de corrupción.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4601" TIME_SLOT_REF1="ts9200" TIME_SLOT_REF2="ts9201">
				<ANNOTATION_VALUE>Entonces nos vamos a ir a hablar con el maestro frente a grupo.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4602" TIME_SLOT_REF1="ts9202" TIME_SLOT_REF2="ts9203">
				<ANNOTATION_VALUE>Ahora, van diciendo, bueno, en el tema de pensiones es muy importante.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4603" TIME_SLOT_REF1="ts9204" TIME_SLOT_REF2="ts9205">
				<ANNOTATION_VALUE>Ellos dicen abrogación de la ley del Issste del 2007.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4604" TIME_SLOT_REF1="ts9206" TIME_SLOT_REF2="ts9207">
				<ANNOTATION_VALUE>No estamos de acuerdo nosotros con esa ley, pero se ha presentado muchas veces la imposibilidad económica financiera de su abrogación por el impacto que tendría, porque no podemos recuperar el pasado, pero sí podemos planear el futuro.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4605" TIME_SLOT_REF1="ts9208" TIME_SLOT_REF2="ts9209">
				<ANNOTATION_VALUE>Es decir, no podemos recuperar lo que no se ahorró durante casi 20 años ya.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4606" TIME_SLOT_REF1="ts9210" TIME_SLOT_REF2="ts9211">
				<ANNOTATION_VALUE>Martí Batres aquí lo explicó.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4607" TIME_SLOT_REF1="ts9212" TIME_SLOT_REF2="ts9213">
				<ANNOTATION_VALUE>O sea, esta bolsa en el sistema solidario que se junta en el gobierno para poder pagar las pensiones se dejó de hacer porque Felipe Calderón decidió que cada quien iba a tener que ahorrar en su propia cuenta y según lo que ahorrar así iba a ser su pensión.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4608" TIME_SLOT_REF1="ts9214" TIME_SLOT_REF2="ts9215">
				<ANNOTATION_VALUE>Pero el presidente López Obrador estableció el Fondo de Pensiones para el Bienestar que lo que hace es complementar lo que te dé tu afore para llevarte a tu último salario, que era la gran ventaja del sistema solidario, que cuando pasabas de trabajador activo a trabajador en retiro, no perdías nivel de vida, no perdías ingresos.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4609" TIME_SLOT_REF1="ts9216" TIME_SLOT_REF2="ts9217">
				<ANNOTATION_VALUE>Eso es lo que hace, es lo que garantiza el Fondo de Pensiones para el Bienestar.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4610" TIME_SLOT_REF1="ts9218" TIME_SLOT_REF2="ts9219">
				<ANNOTATION_VALUE>Y hay una propuesta ahora para seguir avanzando en lograr pensiones dignas, que es lo que se les puso en la mesa de hacer una aseguradora pública para ofartelecer la vertiente pública y solidaria de nuestro sistema de pensiones.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4611" TIME_SLOT_REF1="ts9220" TIME_SLOT_REF2="ts9221">
				<ANNOTATION_VALUE>A ver, también dicen por ahí que nosotros estamos fortaleciendo al asente.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4612" TIME_SLOT_REF1="ts9222" TIME_SLOT_REF2="ts9223">
				<ANNOTATION_VALUE>Nosotros tenemos una relación institucional con todo el magisterio nacional y su representación legal.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4613" TIME_SLOT_REF1="ts9224" TIME_SLOT_REF2="ts9225">
				<ANNOTATION_VALUE>Obviamente quien tiene la mayor número de secciones es el Centro del Sindicato Nacional, con quien tenemos una extraordinaria relación, con quienes trabajamos de la mano siempre atendiendo a los maestros y las maestras.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4614" TIME_SLOT_REF1="ts9226" TIME_SLOT_REF2="ts9227">
				<ANNOTATION_VALUE>Y en el caso de la coordinadora, tiene tres representaciones legales, Chiapas, Oaxaca y Zacatecas.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4615" TIME_SLOT_REF1="ts9228" TIME_SLOT_REF2="ts9229">
				<ANNOTATION_VALUE>Y al igual que lo hacemos con las otras representaciones legales, tenemos mesas permanentes de atención, donde nos dedicamos a atender principalmente los rezagos educativos, que han estado donde son muchos.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4616" TIME_SLOT_REF1="ts9230" TIME_SLOT_REF2="ts9231">
				<ANNOTATION_VALUE>Y nuestra presidenta nos ha dicho, toda demanda legítima debe ser atendida evidentemente con las restricciones presupuestales que tenemos.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4617" TIME_SLOT_REF1="ts9232" TIME_SLOT_REF2="ts9233">
				<ANNOTATION_VALUE>Entonces, quiero decirles a los maestros de Chiapas que hay una atención muy importante a sus demandas.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4618" TIME_SLOT_REF1="ts9234" TIME_SLOT_REF2="ts9235">
				<ANNOTATION_VALUE>Hay recursos extraordinarios muy importantes que van dedicados exclusivamente a atender demandas justas de rezagos educativos.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4619" TIME_SLOT_REF1="ts9236" TIME_SLOT_REF2="ts9237">
				<ANNOTATION_VALUE>Nada de privilegios, nada de recursos dedicados a las dirigencias.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4620" TIME_SLOT_REF1="ts9238" TIME_SLOT_REF2="ts9239">
				<ANNOTATION_VALUE>Lo mismo que en Oaxaca, que tenemos, ya dimos aquí un recuento, hay una inversión de más de 23 mil millones de pesos para Oaxaca, porque nos interesan los niños, las niñas, sus escuelas y el maestro frente a grupo, que esté bien.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4621" TIME_SLOT_REF1="ts9240" TIME_SLOT_REF2="ts9241">
				<ANNOTATION_VALUE>Y también informarle a las y los maestros de Zacatecas, que tenemos un muy buen acuerdo con su representación sindical para atender los rezagos educativos, siempre acompañados de los gobiernos de los estados.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4622" TIME_SLOT_REF1="ts9242" TIME_SLOT_REF2="ts9243">
				<ANNOTATION_VALUE>Y en otros estados donde no hay una representación legal, pero hay representaciones con demandas justas, legítimas, también los atendemos.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4623" TIME_SLOT_REF1="ts9244" TIME_SLOT_REF2="ts9245">
				<ANNOTATION_VALUE>El caso de Guerrero, ¿qué hemos hecho en Guerrero, por ejemplo?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4624" TIME_SLOT_REF1="ts9246" TIME_SLOT_REF2="ts9247">
				<ANNOTATION_VALUE>Hay mucha necesidad de tener más movilidad dentro del magisterio para atender necesidades.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4625" TIME_SLOT_REF1="ts9248" TIME_SLOT_REF2="ts9249">
				<ANNOTATION_VALUE>Ahí tenemos un esquema novedoso, se da un estímulo a la jubilación, los maestros se jubilan, liberan plazas, liberan recursos y nos permite atender aquellos donde tienen alguna necesidad.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4626" TIME_SLOT_REF1="ts9250" TIME_SLOT_REF2="ts9251">
				<ANNOTATION_VALUE>Entonces, estamos trabajando muy bien con la representación legal de la sección 14 en Guerrero, pero también con la parte de la coordinadora.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4627" TIME_SLOT_REF1="ts9252" TIME_SLOT_REF2="ts9253">
				<ANNOTATION_VALUE>Entonces, si hay una atención de las demandas inmediatas y además hay una agenda para atender sus dos principales preocupaciones, como es pensiones dignas, la ley del Issste y la UCICAM, nosotros no</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		</TIER>
	<LINGUISTIC_TYPE LINGUISTIC_TYPE_ID="default-lt" TIME_ALIGNABLE="true" GRAPHIC_REFERENCES="false" />
	<CONSTRAINT STEREOTYPE="Time_Subdivision" DESCRIPTION="Time subdivision of parent annotation's time interval, no time gaps allowed within this interval" />
	<CONSTRAINT STEREOTYPE="Symbolic_Subdivision" DESCRIPTION="Symbolic subdivision of a parent annotation. Annotations refering to the same parent are ordered" />
	<CONSTRAINT STEREOTYPE="Symbolic_Association" DESCRIPTION="1-1 association with a parent annotation" />
	<CONSTRAINT STEREOTYPE="Included_In" DESCRIPTION="Time alignable annotations within the parent annotation's time interval, gaps are allowed" />
	<TIER TIER_ID="SUBTITLE_SHIFTED" LINGUISTIC_TYPE_REF="default-lt"><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_0" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_0_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_0_2"><ANNOTATION_VALUE>y jóvenes mexicanos a través de la educación y la innovación.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_1" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_1_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_1_2"><ANNOTATION_VALUE>Uno de sus mayores sueños es estudiar ingeniería en la UNAM.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_2" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_2_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_2_2"><ANNOTATION_VALUE>Hoy es el informe justamente para concluir el Mundial Social.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_3" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_3_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_3_2"><ANNOTATION_VALUE>Únicamente quisiera, pues yo, solicitar su apoyo.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_4" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_4_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_4_2"><ANNOTATION_VALUE>Infórmense, hay muchísimas actividades que preparamos con mucho profesionalismo, con mucho amor.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_5" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_5_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_5_2"><ANNOTATION_VALUE>Es tiempo de disfrutar el fútbol, de disfrutar la cultura, de disfrutar todo lo que la presidenta Schembau nos ha encargado preparar y trabajar para el pueblo de México.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_6" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_6_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_6_2"><ANNOTATION_VALUE>Y segundo, recuerden, jugamos de locales, todas y todos somos anfitriones.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_7" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_7_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_7_2"><ANNOTATION_VALUE>Muchísimas gracias, presidenta, por esta gran oportunidad y una gran experiencia de trabajar con todo el gobierno de México.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_8" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_8_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_8_2"><ANNOTATION_VALUE>Gracias, gracias, presidenta.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_9" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_9_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_9_2"><ANNOTATION_VALUE>Muy buenos días a todas y a todos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_10" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_10_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_10_2"><ANNOTATION_VALUE>Pues sigue rodando el balón y también los sueños en el Mundial Social, miles de personas que en todo el país, en todos los estados del país, jugaron en diversas modalidades este juego que nos apasiona, ya sea en fútbol de salón o fútbol sin correr o el fútbol adaptado, demostrando que el fútbol también es salud, comunidad e inclusión.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_11" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_11_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_11_2"><ANNOTATION_VALUE>Y hoy, por el esfuerzo de estos equipos y por la iniciativa de la presidenta Claudia Schembau, van a tener esta extraordinaria oportunidad de acudir a un partido de la Copa del Mundo.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_12" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_12_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_12_2"><ANNOTATION_VALUE>La primera, por favor, las primeras ganadoras del torneo de futsal femenil Sub -21, un torneo que se diseñó con el propósito de convertirse en la cantera para la Selección Nacional de Futsal rumbo al Mundial Femenil de Futsal FIFA 2029, son el equipo de la UACH, de la Universidad Autónoma de Chihuahua, que irá a un partido del junto con su entrenadora y su cuerpo técnico.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_13" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_13_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_13_2"><ANNOTATION_VALUE>En este equipo, por cierto, está Ángela de la Peña, goleadora de todo el torneo y además que estuvo en la visoría de FIFA para la selección.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_14" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_14_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_14_2"><ANNOTATION_VALUE>Y en segundo lugar, el equipo de las Leonas de la Universidad Politécnica de San Luis Potosí.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_15" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_15_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_15_2"><ANNOTATION_VALUE>En el segundo torneo, un torneo donde el fútbol adaptado demuestra inclusión, es el T -21, o sea, nos pasa en la siguiente, por favor, fue un torneo de 16 equipos de niñas y niños con síndrome de Down, provenientes de tres estados del país y los campeones fueron los tuneros de San Luis que se alzaron con el triunfo el 25 de abril en Huastepec.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_16" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_16_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_16_2"><ANNOTATION_VALUE>Y el último, en la siguiente, fue fútbol sin correr, la emoción por el juego que no tiene edad, en esta modalidad diseñada para previgilar técnica estratégica y evitar lesiones y poder seguir jugando toda la vida.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_17" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_17_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_17_2"><ANNOTATION_VALUE>Aquí los campeones de la categoría oro fueron selecciones mixtas, fue el equipo purépechas de Morelia, Michoacán y los campeones de la categoría plata, los soques de Tuxtla Gutiérrez, demostrando que el amor por el fútbol no se jubila.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_18" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_18_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_18_2"><ANNOTATION_VALUE>Y dejamos que sean ellas y ellos, sus voces, quienes ganaron este premio, quienes puedan hablar, pues que siga rodando el balón y siga rodando por muchos años más también en el Seguro Social.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_19" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_19_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_19_2"><ANNOTATION_VALUE>Gracias, presidente.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_20" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_20_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_20_2"><ANNOTATION_VALUE>Tenemos un pequeño video y después sigue Abrahma.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_21" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_21_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_21_2"><ANNOTATION_VALUE>Es una experiencia que nunca vamos a olvidar.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_22" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_22_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_22_2"><ANNOTATION_VALUE>Hola, yo soy Ángel Manuel Senas, tengo 21 años, juego con tunejos de San Luis Potosí y las 10 Inns.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_23" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_23_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_23_2"><ANNOTATION_VALUE>El fútbol para mí es una forma de vivir, es lo máximo y así apilamos a la juventud.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_24" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_24_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_24_2"><ANNOTATION_VALUE>Se disfrutó, se batalló, yo creo que desde el primer partido lo queríamos, no lo esperábamos, pero pues llegamos muchísimo más lejos de lo que nosotros queríamos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_25" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_25_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_25_2"><ANNOTATION_VALUE>Y de verdad te lo digo, una experiencia increíble.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_26" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_26_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_26_2"><ANNOTATION_VALUE>A mí esta experiencia me permitió vivir momentos inolvidables junto a mis compañeros porque me apoyaron, especialmente a mí, yo nunca había jugado y les doy las gracias a ellos, al Inns y a la presidenta Claudia Sherman.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_27" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_27_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_27_2"><ANNOTATION_VALUE>Le agradezco mucho que se nos dé la oportunidad a nosotras las personas mayores de seguir participando en este tipo de eventos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_28" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_28_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_28_2"><ANNOTATION_VALUE>Gracias por acercar al deporte a nuestras comunidades y por hacer posible esta experiencia que nunca vamos a olvidar.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_29" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_29_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_29_2"><ANNOTATION_VALUE>Nos vemos en el mundial.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_30" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_30_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_30_2"><ANNOTATION_VALUE>Me doy muchas gracias a la presidenta Claudia Sherman y al Instituto Americano del Seguro Social por hacer estos eventos que hacen participar a las personas de la edad avanzada que nunca nos impide jugar un buen fútbol.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_31" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_31_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_31_2"><ANNOTATION_VALUE>Quiero agradecer a la presidenta Claudia Sherman de darnos la oportunidad de asistir a un partido mundial de fútbol.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_32" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_32_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_32_2"><ANNOTATION_VALUE>Gracias, presidenta.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_33" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_33_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_33_2"><ANNOTATION_VALUE>Gracias.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_34" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_34_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_34_2"><ANNOTATION_VALUE>Presidenta, muy buenos días a todas y a todos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_35" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_35_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_35_2"><ANNOTATION_VALUE>Hoy es un día histórico para nuestro país, ya lo comentó mi amiga Gaby.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_36" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_36_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_36_2"><ANNOTATION_VALUE>Mientras vivimos la emoción del fútbol, también platicarles que millones de jóvenes lo están jugando y participando a su manera entre ellas y ellos en el marco del mundial social.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_37" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_37_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_37_2"><ANNOTATION_VALUE>A través de esta estrategia y por instrucción de la presidenta, miles de canchas, plazas y espacios públicos se han convertido en puntos de encuentro para convivir, jugar y hasta ser nuevos amigos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_38" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_38_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_38_2"><ANNOTATION_VALUE>Se han realizado 6 mil 875 tequios para recuperar canchas y espacios deportivos entre las jóvenes de todo el país con la participación de más de un millón 300 mil de ellas y de ellos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_39" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_39_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_39_2"><ANNOTATION_VALUE>Más de 115 mil equipos han llenado esas canchas de alegría y entusiasmo en las ya famosas cascaritas de fútbol.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_40" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_40_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_40_2"><ANNOTATION_VALUE>Y en las últimas semanas los jóvenes se organizaron y transformaron 4 mil 645 paredes y muros de todo el país para convertirlos en murales mundialistas que son expresiones de arte, identidad y orgullo.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_41" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_41_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_41_2"><ANNOTATION_VALUE>Y hoy queremos compartir una gran noticia, también lo mencionaba nuestra amiga Gaby.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_42" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_42_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_42_2"><ANNOTATION_VALUE>De esta jornada nacional fueron seleccionados 200 jóvenes de distintos estados de la República quienes asistirán al mundial tras haber participado en estos murales, en los más creativos y más representativos de todo México.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_43" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_43_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_43_2"><ANNOTATION_VALUE>Esta selección se realizó con el acompañamiento de compañeras y compañeros muralistas jóvenes de nuestro país.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_44" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_44_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_44_2"><ANNOTATION_VALUE>Agradecerle mucho también el apoyo decidido de Gabriela Cuevas en esta tarea y de la Secretaría de Gobernación.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_45" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_45_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_45_2"><ANNOTATION_VALUE>Estas y estos jóvenes representan a millones de mexicanas y mexicanos que se sumaron al Mundial Social a través del deporte, el arte y el trabajo comunitario, demostrando que las nuevas generaciones son protagonistas de la transformación que hoy vive nuestro país.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_46" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_46_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_46_2"><ANNOTATION_VALUE>Y si nos lo permite, presidenta, queremos compartir un breve video realizado por ellas y por ellos, agradeciendo esta invitación.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_47" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_47_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_47_2"><ANNOTATION_VALUE>Adelante, por favor.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_48" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_48_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_48_2"><ANNOTATION_VALUE>Hola, soy Yojan, estudiante del Tecnológico de Colima.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_49" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_49_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_49_2"><ANNOTATION_VALUE>Hemos ganado el segundo lugar en los tequios.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_50" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_50_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_50_2"><ANNOTATION_VALUE>No pensé que por medio de este mural que hice con mi grupo pudiéramos ganarnos un boleto para ver un partido del mundial.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_51" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_51_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_51_2"><ANNOTATION_VALUE>Estoy muy emocionada por ir a verlo.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_52" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_52_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_52_2"><ANNOTATION_VALUE>Muchas gracias, presidenta.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_53" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_53_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_53_2"><ANNOTATION_VALUE>Por esta gran oportunidad de poder vivir un mundial.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_54" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_54_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_54_2"><ANNOTATION_VALUE>¡Qué gran ilusión vivir un mundial!</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_55" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_55_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_55_2"><ANNOTATION_VALUE>Y muy feliz porque no me esperaba ser una de las ganadoras.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_56" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_56_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_56_2"><ANNOTATION_VALUE>Por apoyar a las y los jóvenes.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_57" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_57_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_57_2"><ANNOTATION_VALUE>Por esta oportunidad en la que nos permites a millas más estudiantes que participan y las asisten al mundial.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_58" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_58_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_58_2"><ANNOTATION_VALUE>Por esta oportunidad de vivir el mundial en familia.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_59" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_59_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_59_2"><ANNOTATION_VALUE>¡Nos vamos al mundial!</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_60" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_60_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_60_2"><ANNOTATION_VALUE>La va a romper en la selección y pues espero estar ahí presente.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_61" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_61_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_61_2"><ANNOTATION_VALUE>Muchísimas gracias de corazón.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_62" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_62_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_62_2"><ANNOTATION_VALUE>De verdad que es muy emocionante.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_63" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_63_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_63_2"><ANNOTATION_VALUE>Presidenta, le quiero agradecer por tomarnos en cuenta a los jóvenes.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_64" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_64_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_64_2"><ANNOTATION_VALUE>Gracias, presidenta, y nos vemos al mundial.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_65" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_65_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_65_2"><ANNOTATION_VALUE>Gracias, y lo de Shimon, por darnos esta oportunidad.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_66" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_66_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_66_2"><ANNOTATION_VALUE>Por apoyar a las y los jóvenes y formar parte de esta gran experiencia y vivir el mundial.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_67" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_67_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_67_2"><ANNOTATION_VALUE>Gracias, presidenta, por esta gran oportunidad.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_68" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_68_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_68_2"><ANNOTATION_VALUE>Por esto y pues nada, nos vemos en el mundial.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_69" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_69_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_69_2"><ANNOTATION_VALUE>Para mí es una experiencia muy buena la que va a haber de ir al mundial.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_70" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_70_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_70_2"><ANNOTATION_VALUE>¿Vamos a ir al mundial?</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_71" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_71_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_71_2"><ANNOTATION_VALUE>Pues...</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_72" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_72_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_72_2"><ANNOTATION_VALUE>Muchas gracias, señorita presidenta.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_73" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_73_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_73_2"><ANNOTATION_VALUE>Adiós.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_74" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_74_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_74_2"><ANNOTATION_VALUE>Queremos agradecer a nuestra presidenta Claudia.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_75" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_75_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_75_2"><ANNOTATION_VALUE>¡Muchas gracias, presidenta!</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_76" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_76_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_76_2"><ANNOTATION_VALUE>¡Nos vamos al mundial!</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_77" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_77_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_77_2"><ANNOTATION_VALUE>Bueno, pues aprovecho para invitar a todos y a todas las jóvenes del país a salir a las plazas públicas, canchas, donde cada mes y de manera permanente realizamos actividades de participación y ahora enfocadas en el fútbol.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_78" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_78_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_78_2"><ANNOTATION_VALUE>Así que anímense a participar.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_79" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_79_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_79_2"><ANNOTATION_VALUE>Vamos a ser nuevas amigas, amigos, vivir experiencias increíbles, dejar un rato el celular para encontrarse con otras personas y compartir.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_80" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_80_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_80_2"><ANNOTATION_VALUE>Para enterarse de las próximas actividades, aquí están nuestras redes sociales.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_81" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_81_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_81_2"><ANNOTATION_VALUE>Por favor, escríbanos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_82" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_82_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_82_2"><ANNOTATION_VALUE>Y bueno, pues en este día histórico enviamos un saludo y todo nuestro respaldo a la Selección Mexicana de Fútbol, su esfuerzo en la cancha y reflejo de disciplina, el talento y la entrega de nuestra gente.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_83" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_83_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_83_2"><ANNOTATION_VALUE>Nos vemos en el quinto partido.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_84" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_84_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_84_2"><ANNOTATION_VALUE>Muchas gracias, presidenta.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_85" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_85_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_85_2"><ANNOTATION_VALUE>Muy buenos días a todas y a todos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_86" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_86_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_86_2"><ANNOTATION_VALUE>Pues tenemos que estar muy felices y orgullosos de vivir en este gran país que por tercera ocasión tiene una Copa Mundial.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_87" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_87_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_87_2"><ANNOTATION_VALUE>Y como todo turista, cuando llegas a un país, a un estado nuevo, pues surgen diferentes preguntas.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_88" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_88_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_88_2"><ANNOTATION_VALUE>Por eso la presidenta nos ha pedido y creamos los kioscos México Contigo.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_89" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_89_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_89_2"><ANNOTATION_VALUE>Hay tres kioscos de información turística, pero que tienen más que eso.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_90" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_90_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_90_2"><ANNOTATION_VALUE>Tenemos en las tres ciudades sedes.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_91" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_91_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_91_2"><ANNOTATION_VALUE>En la Ciudad de México está en la Gloreta de Insurgentes.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_92" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_92_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_92_2"><ANNOTATION_VALUE>En Nuevo León está en el Parque Fundidora.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_93" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_93_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_93_2"><ANNOTATION_VALUE>Y en Jalisco está en la plaza de los dos templos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_94" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_94_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_94_2"><ANNOTATION_VALUE>Siguiente, por favor.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_95" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_95_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_95_2"><ANNOTATION_VALUE>Aquí podemos encontrar diferentes dependencias.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_96" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_96_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_96_2"><ANNOTATION_VALUE>Instituto Nacional de Migración, donde está dando orientación y información en los diferentes programas que tienen con las secretarías, las dependencias, a nuestros paisanos y con nacionales.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_97" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_97_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_97_2"><ANNOTATION_VALUE>Siguiente, por favor.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_98" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_98_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_98_2"><ANNOTATION_VALUE>También está el Consulado de Estados Unidos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_99" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_99_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_99_2"><ANNOTATION_VALUE>Estamos brindando asistencia en trámites de pasaportes, en reportes consulares, en fin, para que todos los turistas internacionales puedan acudir con nosotros.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_100" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_100_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_100_2"><ANNOTATION_VALUE>Siguiente, por favor.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_101" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_101_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_101_2"><ANNOTATION_VALUE>Ángeles Verdes.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_102" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_102_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_102_2"><ANNOTATION_VALUE>Recuerden que no solamente es asistencia vial, pueden marcar hoy 078 -247, es asistencia turística bilingüe.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_103" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_103_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_103_2"><ANNOTATION_VALUE>Si no sabes dónde quedarte, si no sabes qué partido viene, qué ruta tomar, ahí van a encontrar toda la información.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_104" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_104_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_104_2"><ANNOTATION_VALUE>Siguiente, por favor.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_105" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_105_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_105_2"><ANNOTATION_VALUE>Movilidad.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_106" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_106_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_106_2"><ANNOTATION_VALUE>Te ayudamos a hacer los planes de movilidad alternos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_107" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_107_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_107_2"><ANNOTATION_VALUE>Qué ruta del metro, cómo llegar a tu destino, cómo llegar al estadio, cómo llegar al FIFA Fest.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_108" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_108_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_108_2"><ANN