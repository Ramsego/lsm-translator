			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4515" TIME_SLOT_REF1="ts9028" TIME_SLOT_REF2="ts9029">
				<ANNOTATION_VALUE>Te entregamos un librito de la historia de México por tercera ocasión ser mundialista.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4516" TIME_SLOT_REF1="ts9030" TIME_SLOT_REF2="ts9031">
