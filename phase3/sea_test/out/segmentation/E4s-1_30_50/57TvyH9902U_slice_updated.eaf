		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4540" TIME_SLOT_REF1="ts9078" TIME_SLOT_REF2="ts9079">
				<ANNOTATION_VALUE>En las tres sedes mundialistas, encontrarán los kioscos México contigo.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
