		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4229" TIME_SLOT_REF1="ts8456" TIME_SLOT_REF2="ts8457">
				<ANNOTATION_VALUE>Gracias, presidenta, por esta gran oportunidad.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4230" TIME_SLOT_REF1="ts8458" TIME_SLOT_REF2="ts8459">
				<ANNOTATION_VALUE>Por esto y pues nada, nos vemos en el mundial.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4231" TIME_SLOT_REF1="ts8460" TIME_SLOT_REF2="ts8461">
				<ANNOTATION_VALUE>Para mí es una experiencia muy buena la que va a haber de ir al mundial.</ANNOTATION_VALUE>
