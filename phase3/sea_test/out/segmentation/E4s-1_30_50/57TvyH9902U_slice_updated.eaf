		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4528" TIME_SLOT_REF1="ts9054" TIME_SLOT_REF2="ts9055">
				<ANNOTATION_VALUE>Ya están en funciones.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4529" TIME_SLOT_REF1="ts9056" TIME_SLOT_REF2="ts9057">
				<ANNOTATION_VALUE>Abren a partir de las 9 de la mañana y están todos los días de lunes a domingo.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4530" TIME_SLOT_REF1="ts9058" TIME_SLOT_REF2="ts9059">
				<ANNOTATION_VALUE>Así que los esperamos.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4531" TIME_SLOT_REF1="ts9060" TIME_SLOT_REF2="ts9061">
				<ANNOTATION_VALUE>Y les recuerdo que a partir de hoy está México de mis sabores.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4532" TIME_SLOT_REF1="ts9062" TIME_SLOT_REF2="ts9063">
				<ANNOTATION_VALUE>En la aplicación podrán encontrar los 156 puntos de fiestas México donde van a poder vivir el mundial en todo el país.</ANNOTATION_VALUE>
