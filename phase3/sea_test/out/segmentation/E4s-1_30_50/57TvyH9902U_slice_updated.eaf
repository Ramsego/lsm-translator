			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4539" TIME_SLOT_REF1="ts9076" TIME_SLOT_REF2="ts9077">
				<ANNOTATION_VALUE>Por eso, durante la fiesta máxima del fútbol, México estará contigo.</ANNOTATION_VALUE>
