		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4226" TIME_SLOT_REF1="ts8450" TIME_SLOT_REF2="ts8451">
				<ANNOTATION_VALUE>Gracias, presidenta, y nos vemos al mundial.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
