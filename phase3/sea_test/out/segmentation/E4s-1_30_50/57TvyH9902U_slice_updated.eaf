		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4216" TIME_SLOT_REF1="ts8430" TIME_SLOT_REF2="ts8431">
				<ANNOTATION_VALUE>¡Qué gran ilusión vivir un mundial!</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4217" TIME_SLOT_REF1="ts8432" TIME_SLOT_REF2="ts8433">
				<ANNOTATION_VALUE>Y muy feliz porque no me esperaba ser una de las ganadoras.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4218" TIME_SLOT_REF1="ts8434" TIME_SLOT_REF2="ts8435">
				<ANNOTATION_VALUE>Por apoyar a las y los jóvenes.</ANNOTATION_VALUE>
