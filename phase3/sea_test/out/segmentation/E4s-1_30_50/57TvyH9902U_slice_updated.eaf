				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4535" TIME_SLOT_REF1="ts9068" TIME_SLOT_REF2="ts9069">
				<ANNOTATION_VALUE>Cuando llegas a un país nuevo, siempre surgen preguntas.</ANNOTATION_VALUE>
