" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_121_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_121_2"><ANNOTATION_VALUE>Siguiente.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_122" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_122_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_122_2"><ANNOTATION_VALUE>También tenemos dependencias internacionales como la ONU, donde están dando pláticas contra las drogas y, sobre todo, en el tema de la política del turismo deportivo.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_123" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_123_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_123_2"><ANNOTATION_VALUE>Siguiente, por favor.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_124" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_124_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_124_2"><ANNOTATION_VALUE>Primeros auxilios.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_125" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_125_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_125_2"><ANNOTATION_VALUE>También están capacitados.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_126" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_126_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_126_2"><ANNOTATION_VALUE>Está la Cruz Roja con nosotros.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_127" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_127_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_127_2"><ANNOTATION_VALUE>Para cualquier tema, pueden acudir a estos kioscos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_128" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_128_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_128_2"><ANNOTATION_VALUE>Siguiente.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_129" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_129_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_129_2"><ANNOTATION_VALUE>Y, pues, sobre todo, la aplicación de AppMéxico te invita.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_130" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_130_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_130_2"><ANNOTATION_VALUE>Tienes unos totems muy didácticos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_131" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_131_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_131_2"><ANNOTATION_VALUE>Recuerden que ahí puedes consultar cómo turistar por todo México, desde la ciudad de Cedes, 290 rutas, qué comer, etcétera.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_132" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_132_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_132_2"><ANNOTATION_VALUE>Entonces, pues, estos kioscos están abiertos para todos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_133" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_133_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_133_2"><ANNOTATION_VALUE>Ya están en funciones.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_134" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_134_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_134_2"><ANNOTATION_VALUE>Abren a partir de las 9 de la mañana y están todos los días de lunes a domingo.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_135" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_135_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_135_2"><ANNOTATION_VALUE>Así que los esperamos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_136" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_136_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_136_2"><ANNOTATION_VALUE>Y les recuerdo que a partir de hoy está México de mis sabores.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_137" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_137_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_137_2"><ANNOTATION_VALUE>En la aplicación podrán encontrar los 156 puntos de fiestas México donde van a poder vivir el mundial en todo el país.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_138" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_138_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_138_2"><ANNOTATION_VALUE>Y los dejo con este video.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_139" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_139_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_139_2"><ANNOTATION_VALUE>Muchísimas gracias.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_140" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_140_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_140_2"><ANNOTATION_VALUE>Cuando llegas a un país nuevo, siempre surgen preguntas.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_141" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_141_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_141_2"><ANNOTATION_VALUE>¿Cómo puedo llegar?</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_142" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_142_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_142_2"><ANNOTATION_VALUE>¿Qué puedo visitar?</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_143" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_143_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_143_2"><ANNOTATION_VALUE>¿Dónde encuentro ayuda si la necesito?</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_144" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_144_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_144_2"><ANNOTATION_VALUE>Por eso, durante la fiesta máxima del fútbol, México estará contigo.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_145" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_145_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_145_2"><ANNOTATION_VALUE>En las tres sedes mundialistas, encontrarán los kioscos México contigo.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_146" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_146_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_146_2"><ANNOTATION_VALUE>Espacios de atención turística donde encontrarás información clara, confiable y en tu idioma.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_147" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_147_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_147_2"><ANNOTATION_VALUE>Desde recomendaciones para disfrutar la ciudad hasta orientación para moverte de forma segura.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_148" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_148_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_148_2"><ANNOTATION_VALUE>¿Perdiste tu pasaporte o algún documento importante?</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_149" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_149_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_149_2"><ANNOTATION_VALUE>¿Tuviste un problema con algún servicio turístico o necesitas ayuda?</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_150" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_150_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_150_2"><ANNOTATION_VALUE>¿Requieres ayuda médica o atención ante una emergencia?</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_151" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_151_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_151_2"><ANNOTATION_VALUE>En los kioscos México contigo encontrarás acompañamiento y canalización con las instituciones correspondientes.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_152" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_152_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_152_2"><ANNOTATION_VALUE>Porque queremos que disfrutes cada experiencia con tranquilidad y confianza.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_153" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_153_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_153_2"><ANNOTATION_VALUE>Y que sepas que siempre hay un lugar al cual puedes acudir.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_154" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_154_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_154_2"><ANNOTATION_VALUE>Sin importar tu nacionalidad, tu idioma o quién eres.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_155" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_155_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_155_2"><ANNOTATION_VALUE>México contigo es un espacio seguro, incluyente y pensado para ti.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_156" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_156_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_156_2"><ANNOTATION_VALUE>Descubre nuestras ciudades.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_157" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_157_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_157_2"><ANNOTATION_VALUE>Y disfruta cada momento con la confianza de que México está contigo.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_158" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_158_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_158_2"><ANNOTATION_VALUE>Ten a vivir la emoción del fútbol porque México está de buena.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_159" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_159_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_159_2"><ANNOTATION_VALUE>Con su permiso, presidenta.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_160" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_160_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_160_2"><ANNOTATION_VALUE>Muy buenos días a todas y a todos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_161" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_161_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_161_2"><ANNOTATION_VALUE>Primero informar que el día de ayer se desarrollaron en la ciudad de México dos movilizaciones relevantes.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_162" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_162_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_162_2"><ANNOTATION_VALUE>La primera integrada por aproximadamente dos mil personas que partió del casco de Santo Tomás, hacia el cine Cosmos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_163" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_163_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_163_2"><ANNOTATION_VALUE>Esto en conmemoración de hechos sucedidos en 1971, conocidos como el Alconazo.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_164" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_164_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_164_2"><ANNOTATION_VALUE>Se llevó a cabo esta movilización de manera ordenada y concluyó sin incidentes.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_165" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_165_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_165_2"><ANNOTATION_VALUE>La segunda movilización se efectuó por la noche.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_166" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_166_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_166_2"><ANNOTATION_VALUE>Estuvo conformada por varios cientos de personas entre ellas madres y padres y familiares de personas desaparecidas, así como integrantes de colectivos y organizaciones que acompañan su causa.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_167" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_167_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_167_2"><ANNOTATION_VALUE>En esta movilización, la Secretaría de Gobernación estuvo presente en todo momento, junto con la Comisionada Nacional de Búsqueda y la Comisión Ejecutiva de Atención a Víctimas, brindando atención y acompañamiento a las familias participantes.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_168" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_168_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_168_2"><ANNOTATION_VALUE>Respecto de esta manifestación, expresar en primer lugar nuestro respeto, solidaridad, a las madres y familias buscadoras.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_169" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_169_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_169_2"><ANNOTATION_VALUE>Comprendemos lo que representa la ausencia de un ser querido y reiteramos que el Gobierno de México trabaja todos los días en coordinación con las autoridades estatales y las instituciones competentes en la localización de personas desaparecidas.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_170" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_170_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_170_2"><ANNOTATION_VALUE>Las buscadoras y los colectivos han sido atendidos de manera permanente y lo seguiremos haciendo con todo nuestro esfuerzo.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_171" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_171_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_171_2"><ANNOTATION_VALUE>También es importante señalar que contamos con información que indica la presencia no solamente de los colectivos de la Ciudad de México y los colectivos de Jalisco, sino que algunas personas provenientes del Estado de Jalisco recibieron apoyo para trasladarse a esta movilización.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_172" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_172_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_172_2"><ANNOTATION_VALUE>Estamos recabando toda la información para conocer el origen de esos apoyos y determinar si existió alguna intención ajena a la legítima exigencia de búsqueda y justicia que encabezan las familias.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_173" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_173_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_173_2"><ANNOTATION_VALUE>Por otra parte, también hoy la CENTE ha expresado públicamente que la movilización prevista para esta mañana se hará de manera pacífica.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_174" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_174_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_174_2"><ANNOTATION_VALUE>Por otra parte, y ya respecto al inicio de la Copa Mundial de Fútbol 2026, queremos ser muy claros, el Mundial va y se desarrollará con normalidad.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_175" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_175_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_175_2"><ANNOTATION_VALUE>A todas las personas que acudirán a los eventos relacionados con la inauguración de la Copa Mundial de Fútbol les informamos que existen las condiciones necesarias para garantizar su acceso, su seguridad y el desarrollo de las actividades programadas.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_176" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_176_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_176_2"><ANNOTATION_VALUE>En conjunto con el gobierno de la Ciudad de México, con todas las autoridades del gobierno de México, nosotros podemos garantizar la normalidad de las actividades.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_177" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_177_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_177_2"><ANNOTATION_VALUE>México está listo para recibir a miles de visitantes en nuestro país y esta es una fiesta para los amantes del fútbol, pero también una celebración.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_178" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_178_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_178_2"><ANNOTATION_VALUE>Les damos la bienvenida y reiteramos nuestro compromiso para que esta jornada se desarrolle en paz, tranquilidad y con pleno respeto a los derechos de todas y de todos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_179" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_179_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_179_2"><ANNOTATION_VALUE>Con su permiso, presidenta.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_180" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_180_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_180_2"><ANNOTATION_VALUE>Para informarles de la reunión que tuvimos ayer en la Secretaría de Gobernación, encabezado por la secretaria Rosa Isela, por el director del Issste, Martí Batres, y su servidor y el equipo de la Secretaría de Educación Pública, invitamos a las y los maestros del Asente a reunirnos nuevamente.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_181" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_181_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_181_2"><ANNOTATION_VALUE>Es la cuarta reunión.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_182" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_182_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_182_2"><ANNOTATION_VALUE>¿Por qué los convocamos?</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_183" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_183_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_183_2"><ANNOTATION_VALUE>Porque tenemos una voluntad de diálogo permanente.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_184" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_184_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_184_2"><ANNOTATION_VALUE>Pero les teníamos preparada mucha más información de las propuestas que ha hecho el gobierno de México a dos de sus principales demandas.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_185" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_185_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_185_2"><ANNOTATION_VALUE>El tema de la UCCAM.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_186" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_186_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_186_2"><ANNOTATION_VALUE>Hicimos una amplísima exposición de cómo ha cambiado históricamente el marco jurídico, cómo ha cambiado la relación entre el Estado mexicano y los maestros.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_187" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_187_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_187_2"><ANNOTATION_VALUE>Desde 1946 a la fecha, cómo evolucionó la regulación en el apartado B del artículo 123, luego la reforma al tercero constitucional.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_188" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_188_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_188_2"><ANNOTATION_VALUE>Es una información muy útil para atender el planteamiento que ha hecho nuestra presidenta.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_189" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_189_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_189_2"><ANNOTATION_VALUE>En su compromiso número 27 de los 100 que le hizo a la nación, a partir de múltiples peticiones de maestros en todo el país y maestras que le decían a la presidenta en su campaña, queremos cambiar a la UCCAM.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_190" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_190_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_190_2"><ANNOTATION_VALUE>Entonces ahí está el compromiso de campaña que se va a atender.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_191" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_191_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_191_2"><ANNOTATION_VALUE>¿Qué queremos?</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_192" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_192_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_192_2"><ANNOTATION_VALUE>¿A qué los invitamos a ellos?</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_193" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_193_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_193_2"><ANNOTATION_VALUE>A que participen en el diseño que vamos a hacer de esta reforma, de esta iniciativa.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_194" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_194_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_194_2"><ANNOTATION_VALUE>Sin embargo, pues ya hay un rechazo a una iniciativa que todavía no existe.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_195" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_195_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_195_2"><ANNOTATION_VALUE>Entonces les dijimos, bueno, pues para que no tengan dudas, participen en una mesa con sus abogados, una mesa técnica, y que vayan dando cuenta que se consideren sus aportaciones en la construcción de esta ley.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_196" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_196_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_196_2"><ANNOTATION_VALUE>Pero lo que está claro es que no podemos quedarnos nada más escuchando a un grupo de maestros.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_197" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_197_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_197_2"><ANNOTATION_VALUE>La presidenta ha dicho, esta reforma es tan importante porque va a definir, va a tener mucho impacto en la vida de las y los maestros, por lo tanto, las y los maestros deben decidir.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_198" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_198_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_198_2"><ANNOTATION_VALUE>Por eso ya anunciamos, es nuestro plan de trabajo que vamos a cumplir.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_199" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_199_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_199_2"><ANNOTATION_VALUE>Vamos a hacer una consulta, escuela por escuela, maestro por maestro, para que ellos decidan esta nueva relación entre el Estado y el Magisterio, donde prevalezca los derechos laborales, la transparencia y erradiquemos cualquier posibilidad de caer en los vicios que había en el pasado, de corrupción, de amigismo, de nepotismo, de influyentismo y de venta de plazas.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_200" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_200_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_200_2"><ANNOTATION_VALUE>No vamos a regresar a eso.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_201" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_201_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_201_2"><ANNOTATION_VALUE>Y como somos un movimiento que viene directamente del pueblo, de escuchar a la gente, pues tenemos que ir abajo con el pueblo, con el maestro que está frente a grupo, que él pueda hablar, no nada más quedarnos con una representación, sino que las y los maestros decidan.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_202" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_202_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_202_2"><ANNOTATION_VALUE>Esa es la intención.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_203" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_203_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_203_2"><ANNOTATION_VALUE>Y ya anunciamos que en el regreso a clases, en agosto, en esta semana, donde los maestros siempre entran una semana antes a clase, porque preparan el siguiente ciclo escolar, entonces es el marco ideal para tener esta discusión sobre el UCICAM y que ellos puedan decidir, por ejemplo, quién debe decidir sobre el ingreso de los maestros, sobre los ascensos, sobre las promociones.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_204" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_204_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_204_2"><ANNOTATION_VALUE>Hay varias alternativas.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_205" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_205_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_205_2"><ANNOTATION_VALUE>Una es que sean los propios maestros, que sean decisiones entre pares, un grupo que se elija de maestros y que ellos elijan o irte a lo que había en el pasado antes, de antes en el gobierno neoliberal, donde pues era una práctica de corrupción.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_206" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_206_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_206_2"><ANNOTATION_VALUE>Entonces nos vamos a ir a hablar con el maestro frente a grupo.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_207" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_207_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_207_2"><ANNOTATION_VALUE>Ahora, van diciendo, bueno, en el tema de pensiones es muy importante.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_208" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_208_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_208_2"><ANNOTATION_VALUE>Ellos dicen abrogación de la ley del Issste del 2007.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_209" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_209_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_209_2"><ANNOTATION_VALUE>No estamos de acuerdo nosotros con esa ley, pero se ha presentado muchas veces la imposibilidad económica financiera de su abrogación por el impacto que tendría, porque no podemos recuperar el pasado, pero sí podemos planear el futuro.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_210" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_210_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_210_2"><ANNOTATION_VALUE>Es decir, no podemos recuperar lo que no se ahorró durante casi 20 años ya.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_211" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_211_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_211_2"><ANNOTATION_VALUE>Martí Batres aquí lo explicó.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_212" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_212_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_212_2"><ANNOTATION_VALUE>O sea, esta bolsa en el sistema solidario que se junta en el gobierno para poder pagar las pensiones se dejó de hacer porque Felipe Calderón decidió que cada quien iba a tener que ahorrar en su propia cuenta y según lo que ahorrar así iba a ser su pensión.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_213" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_213_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_213_2"><ANNOTATION_VALUE>Pero el presidente López Obrador estableció el Fondo de Pensiones para el Bienestar que lo que hace es complementar lo que te dé tu afore para llevarte a tu último salario, que era la gran ventaja del sistema solidario, que cuando pasabas de trabajador activo a trabajador en retiro, no perdías nivel de vida, no perdías ingresos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_214" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_214_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_214_2"><ANNOTATION_VALUE>Eso es lo que hace, es lo que garantiza el Fondo de Pensiones para el Bienestar.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_215" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_215_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_215_2"><ANNOTATION_VALUE>Y hay una propuesta ahora para seguir avanzando en lograr pensiones dignas, que es lo que se les puso en la mesa de hacer una aseguradora pública para ofartelecer la vertiente pública y solidaria de nuestro sistema de pensiones.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_216" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_216_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_216_2"><ANNOTATION_VALUE>A ver, también dicen por ahí que nosotros estamos fortaleciendo al asente.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_217" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_217_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_217_2"><ANNOTATION_VALUE>Nosotros tenemos una relación institucional con todo el magisterio nacional y su representación legal.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_218" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_218_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_218_2"><ANNOTATION_VALUE>Obviamente quien tiene la mayor número de secciones es el Centro del Sindicato Nacional, con quien tenemos una extraordinaria relación, con quienes trabajamos de la mano siempre atendiendo a los maestros y las maestras.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_219" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_219_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_219_2"><ANNOTATION_VALUE>Y en el caso de la coordinadora, tiene tres representaciones legales, Chiapas, Oaxaca y Zacatecas.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_220" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_220_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_220_2"><ANNOTATION_VALUE>Y al igual que lo hacemos con las otras representaciones legales, tenemos mesas permanentes de atención, donde nos dedicamos a atender principalmente los rezagos educativos, que han estado donde son muchos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_221" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_221_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_221_2"><ANNOTATION_VALUE>Y nuestra presidenta nos ha dicho, toda demanda legítima debe ser atendida evidentemente con las restricciones presupuestales que tenemos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_222" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_222_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_222_2"><ANNOTATION_VALUE>Entonces, quiero decirles a los maestros de Chiapas que hay una atención muy importante a sus demandas.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_223" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_223_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_223_2"><ANNOTATION_VALUE>Hay recursos extraordinarios muy importantes que van dedicados exclusivamente a atender demandas justas de rezagos educativos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_224" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_224_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_224_2"><ANNOTATION_VALUE>Nada de privilegios, nada de recursos dedicados a las dirigencias.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_225" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_225_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_225_2"><ANNOTATION_VALUE>Lo mismo que en Oaxaca, que tenemos, ya dimos aquí un recuento, hay una inversión de más de 23 mil millones de pesos para Oaxaca, porque nos interesan los niños, las niñas, sus escuelas y el maestro frente a grupo, que esté bien.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_226" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_226_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_226_2"><ANNOTATION_VALUE>Y también informarle a las y los maestros de Zacatecas, que tenemos un muy buen acuerdo con su representación sindical para atender los rezagos educativos, siempre acompañados de los gobiernos de los estados.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_227" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_227_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_227_2"><ANNOTATION_VALUE>Y en otros estados donde no hay una representación legal, pero hay representaciones con demandas justas, legítimas, también los atendemos.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_228" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_228_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_228_2"><ANNOTATION_VALUE>El caso de Guerrero, ¿qué hemos hecho en Guerrero, por ejemplo?</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_229" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_229_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_229_2"><ANNOTATION_VALUE>Hay mucha necesidad de tener más movilidad dentro del magisterio para atender necesidades.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_230" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_230_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_230_2"><ANNOTATION_VALUE>Ahí tenemos un esquema novedoso, se da un estímulo a la jubilación, los maestros se jubilan, liberan plazas, liberan recursos y nos permite atender aquellos donde tienen alguna necesidad.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_231" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_231_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_231_2"><ANNOTATION_VALUE>Entonces, estamos trabajando muy bien con la representación legal de la sección 14 en Guerrero, pero también con la parte de la coordinadora.</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION><ANNOTATION><ALIGNABLE_ANNOTATION ANNOTATION_ID="a_subtitle_57TvyH9902U_slice_232" TIME_SLOT_REF1="SUBTITLE_TS_57TvyH9902U_slice_232_1" TIME_SLOT_REF2="SUBTITLE_TS_57TvyH9902U_slice_232_2"><ANNOTATION_VALUE>Entonces, si hay una atención de las demandas inmediatas y además hay una agenda para atender sus dos principales preocupaciones, como es pensiones dignas, la ley del Issste y la UCICAM, nosotros no</ANNOTATION_VALUE></ALIGNABLE_ANNOTATION></ANNOTATION></TIER></ANNOTATION_DOCUMENT>