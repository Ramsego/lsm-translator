		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4523" TIME_SLOT_REF1="ts9044" TIME_SLOT_REF2="ts9045">
				<ANNOTATION_VALUE>Siguiente.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4524" TIME_SLOT_REF1="ts9046" TIME_SLOT_REF2="ts9047">
				<ANNOTATION_VALUE>Y, pues, sobre todo, la aplicación de AppMéxico te invita.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4525" TIME_SLOT_REF1="ts9048" TIME_SLOT_REF2="ts9049">
				<ANNOTATION_VALUE>Tienes unos totems muy didácticos.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
