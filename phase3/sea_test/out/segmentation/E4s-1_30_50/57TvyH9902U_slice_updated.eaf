		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4521" TIME_SLOT_REF1="ts9040" TIME_SLOT_REF2="ts9041">
				<ANNOTATION_VALUE>Está la Cruz Roja con nosotros.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4522" TIME_SLOT_REF1="ts9042" TIME_SLOT_REF2="ts9043">
				<ANNOTATION_VALUE>Para cualquier tema, pueden acudir a estos kioscos.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
