				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4215" TIME_SLOT_REF1="ts8428" TIME_SLOT_REF2="ts8429">
