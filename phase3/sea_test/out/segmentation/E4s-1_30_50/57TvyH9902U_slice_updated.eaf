			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4225" TIME_SLOT_REF1="ts8448" TIME_SLOT_REF2="ts8449">
				<ANNOTATION_VALUE>Presidenta, le quiero agradecer por tomarnos en cuenta a los jóvenes.</ANNOTATION_VALUE>
