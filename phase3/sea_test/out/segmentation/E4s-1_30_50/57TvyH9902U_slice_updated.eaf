		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4542" TIME_SLOT_REF1="ts9082" TIME_SLOT_REF2="ts9083">
				<ANNOTATION_VALUE>Desde recomendaciones para disfrutar la ciudad hasta orientación para moverte de forma segura.</ANNOTATION_VALUE>
