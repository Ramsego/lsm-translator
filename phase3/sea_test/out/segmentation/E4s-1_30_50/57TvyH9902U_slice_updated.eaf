				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4228" TIME_SLOT_REF1="ts8454" TIME_SLOT_REF2="ts8455">
				<ANNOTATION_VALUE>Por apoyar a las y los jóvenes y formar parte de esta gran experiencia y vivir el mundial.</ANNOTATION_VALUE>
