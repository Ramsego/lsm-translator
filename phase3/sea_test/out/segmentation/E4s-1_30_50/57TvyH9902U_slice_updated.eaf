			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4224" TIME_SLOT_REF1="ts8446" TIME_SLOT_REF2="ts8447">
				<ANNOTATION_VALUE>De verdad que es muy emocionante.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
