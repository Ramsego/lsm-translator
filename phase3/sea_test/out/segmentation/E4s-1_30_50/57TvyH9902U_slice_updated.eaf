		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4219" TIME_SLOT_REF1="ts8436" TIME_SLOT_REF2="ts8437">
				<ANNOTATION_VALUE>Por esta oportunidad en la que nos permites a millas más estudiantes que participan y las asisten al mundial.</ANNOTATION_VALUE>
