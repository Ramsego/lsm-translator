				<ANNOTATION_VALUE>Adiós.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4236" TIME_SLOT_REF1="ts8470" TIME_SLOT_REF2="ts8471">
				<ANNOTATION_VALUE>Queremos agradecer a nuestra presidenta Claudia.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4237" TIME_SLOT_REF1="ts8472" TIME_SLOT_REF2="ts8473">
				<ANNOTATION_VALUE>¡Muchas gracias, presidenta!</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4238" TIME_SLOT_REF1="ts8474" TIME_SLOT_REF2="ts8475">
				<ANNOTATION_VALUE>¡Nos vamos al mundial!</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4239" TIME_SLOT_REF1="ts8476" TIME_SLOT_REF2="ts8477">
				<ANNOTATION_VALUE>Bueno, pues aprovecho para invitar a todos y a todas las jóvenes del país a salir a las plazas públicas, canchas, donde cada mes y de manera permanente realizamos actividades de participación y ahora enfocadas en el fútbol.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4240" TIME_SLOT_REF1="ts8478" TIME_SLOT_REF2="ts8479">
				<ANNOTATION_VALUE>Así que anímense a participar.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4241" TIME_SLOT_REF1="ts8480" TIME_SLOT_REF2="ts8481">
				<ANNOTATION_VALUE>Vamos a ser nuevas amigas, amigos, vivir experiencias increíbles, dejar un rato el celular para encontrarse con otras personas y compartir.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4242" TIME_SLOT_REF1="ts8482" TIME_SLOT_REF2="ts8483">
				<ANNOTATION_VALUE>Para enterarse de las próximas actividades, aquí están nuestras redes sociales.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4243" TIME_SLOT_REF1="ts8484" TIME_SLOT_REF2="ts8485">
				<ANNOTATION_VALUE>Por favor, escríbanos.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4244" TIME_SLOT_REF1="ts8486" TIME_SLOT_REF2="ts8487">
				<ANNOTATION_VALUE>Y bueno, pues en este día histórico enviamos un saludo y todo nuestro respaldo a la Selección Mexicana de Fútbol, su esfuerzo en la cancha y reflejo de disciplina, el talento y la entrega de nuestra gente.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4245" TIME_SLOT_REF1="ts8488" TIME_SLOT_REF2="ts8489">
				<ANNOTATION_VALUE>Nos vemos en el quinto partido.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4246" TIME_SLOT_REF1="ts8490" TIME_SLOT_REF2="ts8491">
				<ANNOTATION_VALUE>Muchas gracias, presidenta.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4247" TIME_SLOT_REF1="ts8492" TIME_SLOT_REF2="ts8493">
				<ANNOTATION_VALUE>Muy buenos días a todas y a todos.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4248" TIME_SLOT_REF1="ts8494" TIME_SLOT_REF2="ts8495">
				<ANNOTATION_VALUE>Pues tenemos que estar muy felices y orgullosos de vivir en este gran país que por tercera ocasión tiene una Copa Mundial.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4249" TIME_SLOT_REF1="ts8496" TIME_SLOT_REF2="ts8497">
				<ANNOTATION_VALUE>Y como todo turista, cuando llegas a un país, a un estado nuevo, pues surgen diferentes preguntas.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4250" TIME_SLOT_REF1="ts8498" TIME_SLOT_REF2="ts8499">
				<ANNOTATION_VALUE>Por eso la presidenta nos ha pedido y creamos los kioscos México Contigo.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4251" TIME_SLOT_REF1="ts8500" TIME_SLOT_REF2="ts8501">
				<ANNOTATION_VALUE>Hay tres kioscos de información turística, pero que tienen más que eso.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4252" TIME_SLOT_REF1="ts8502" TIME_SLOT_REF2="ts8503">
				<ANNOTATION_VALUE>Tenemos en las tres ciudades sedes.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4253" TIME_SLOT_REF1="ts8504" TIME_SLOT_REF2="ts8505">
				<ANNOTATION_VALUE>En la Ciudad de México está en la Gloreta de Insurgentes.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
